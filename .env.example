PORT=3000

# En el servidor real poner NODE_ENV=production (activa la cookie segura, requiere HTTPS)
# NODE_ENV=production

# Clave para firmar la cookie de sesion. Generar una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_KEY=

# Credenciales del unico admin (no hay tabla de usuarios).
# ADMIN_PASSWORD_HASH se genera con: node scripts/hash-password.js "miContraseña"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Numero de WhatsApp donde llegan los pedidos (con codigo de pais, sin +, sin espacios)
WHATSAPP_NUMBER=

# Cloudinary: donde se guardan las fotos de los platos (datos en el Dashboard de la cuenta).
# Si quedan vacias, las fotos se guardan en el disco local (sirve para desarrollar).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
