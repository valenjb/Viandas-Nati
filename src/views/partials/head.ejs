<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="theme-color" content="#6b2737">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <% if (locals.descripcion) { %>
        <%# Lo que se ve al compartir el link (por ejemplo en WhatsApp) %>
        <meta name="description" content="<%= descripcion %>">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Viandas Nati">
        <meta property="og:title" content="<%= title %>">
        <meta property="og:description" content="<%= descripcion %>">
    <% } else { %>
        <%# Las paginas del panel no tienen que aparecer en buscadores %>
        <meta name="robots" content="noindex">
    <% } %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
