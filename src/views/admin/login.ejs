<%- include('../partials/head.ejs') %>

<div class="pagina-login">
    <div class="tarjeta-login">
        <h1 class="marca">Viandas <span class="destacado">Nati</span></h1>
        <p class="kicker">Panel de administración</p>

        <form action="/admin/login" method="POST" class="form-login">
            <div class="campo">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" required autofocus>
            </div>
            <div class="campo">
                <label for="password">Contraseña</label>
                <input type="password" name="password" id="password" required>
            </div>
            <button type="submit" class="btn btn-solido">Ingresar</button>
        </form>

        <% if (error) { %>
            <p class="mensaje-error"><%= error %></p>
        <% } %>
    </div>
</div>

<%- include('../partials/footer.ejs') %>
