<%- include('../partials/head.ejs') %>

<div class="admin-topbar">
    <span class="marca">Viandas <span class="destacado">Nati</span> · Admin</span>
    <a href="/admin" class="btn btn-tenue">Volver</a>
</div>

<div class="admin-contenido">
    <h1 style="font-size: 22px; margin-bottom: 20px;"><%= plato && plato.id ? 'Editar plato' : 'Nuevo plato' %></h1>

    <% if (errores && errores.length > 0) { %>
        <ul class="lista-errores">
            <% errores.forEach(err => { %>
                <li><%= err %></li>
            <% }) %>
        </ul>
    <% } %>

    <form
        action="<%= plato && plato.id ? `/admin/platos/${plato.id}` : '/admin/platos' %>"
        method="POST"
        enctype="multipart/form-data"
        class="form-plato"
    >
        <div class="campo">
            <label for="name">Nombre</label>
            <input type="text" name="name" id="name" required value="<%= plato ? plato.name : '' %>">
        </div>

        <div class="campo">
            <label for="description">Descripción</label>
            <textarea name="description" id="description"><%= plato ? (plato.description || '') : '' %></textarea>
        </div>

        <div class="campo">
            <label for="price">Precio</label>
            <input type="number" name="price" id="price" min="0" step="1" required value="<%= plato ? plato.price : '' %>">
        </div>

        <div class="campo">
            <label for="category">Categoría</label>
            <select name="category" id="category" required>
                <% ['Entrada', 'Plato principal', 'Postre'].forEach(cat => { %>
                    <option value="<%= cat %>" <%= plato && plato.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
            </select>
        </div>

        <div class="campo">
            <label for="tag">Etiqueta (opcional)</label>
            <input type="text" name="tag" id="tag" placeholder="Vegetariano, Liviano, Clásico..." value="<%= plato ? (plato.tag || '') : '' %>">
        </div>

        <div class="campo">
            <label for="image">Foto (opcional)</label>
            <% if (plato && plato.image) { %>
                <img class="imagen-actual" src="<%= plato.image %>" alt="">
            <% } %>
            <input type="file" name="image" id="image" accept="image/png,image/jpeg,image/webp">
        </div>

        <div class="form-acciones">
            <button type="submit" class="btn btn-solido">Guardar</button>
            <a href="/admin" class="btn btn-tenue">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer.ejs') %>
